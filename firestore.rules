rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasUserProfile() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // User document rules
    match /users/{userId} {
      allow read, write: if request.auth != null && isOwner(userId);
      
      // User subcollections
      match /accounts/{accountId} {
        allow read, write: if isOwner(userId);
      }
      
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }

      match /recurringTransactions/{recurringTransactionId} {
        allow read, write: if isOwner(userId);
      }
      
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }
      
      match /investments/{investmentId} {
        allow read, write: if isOwner(userId);
      }
      
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }
      
      match /emi/{emiId} {
        allow read, write: if isOwner(userId);
      }
      
      match /reminders/{reminderId} {
        allow read, write: if isOwner(userId);
      }
      
      match /settlements/{settlementId} {
        allow read, write: if isOwner(userId);
      }
      
      match /policies/{policyId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      match /smartAlerts/{smartAlertId} {
        allow read, write: if isOwner(userId);
      }

      match /notificationSettings/{settingsId} {
        allow read, write: if isOwner(userId);
      }

      // Security module subcollections — user can only access their own security data
      match /securitySessions/{sessionId} {
        allow read, write: if request.auth != null && isOwner(userId);
      }

      match /securityAuditLogs/{logId} {
        allow read, write: if request.auth != null && isOwner(userId);
      }

      // Trading journal subcollection
      match /tradingJournal/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // Net worth snapshots subcollection
      match /netWorthSnapshots/{snapshotId} {
        allow read, write: if isOwner(userId);
      }

      // Documents vault subcollection
      match /documents/{documentId} {
        allow read, write: if isOwner(userId);
      }

      // AI insights subcollection
      match /ai_insights/{insightId} {
        allow read, write: if isOwner(userId);
      }

      // Investment transactions subcollection
      match /investmentTransactions/{txnId} {
        allow read, write: if isOwner(userId);
      }

      // Events subcollection
      match /events/{eventId} {
        allow read, write: if isOwner(userId);
      }

      // Budget subcollections
      match /budgetCategories/{catId} {
        allow read, write: if isOwner(userId);
      }

      match /budgetTracking/{trackId} {
        allow read, write: if isOwner(userId);
      }

      match /budgetAlerts/{alertId} {
        allow read, write: if isOwner(userId);
      }

      // Automations subcollection
      match /automations/{automationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Top-level collection rules: enforce owner-only access and safe creates
    // These rules ensure any document in the listed collections is owned by
    // the authenticated user. Queries must therefore be scoped by `userId`
    // to succeed (the client code already uses `where('userId','==', uid)`).
    function isOwnerField() {
      return request.auth != null && (
        // For reads/updates/deletes resource exists
        (resource != null && resource.data.userId == request.auth.uid) ||
        // For creates use request.resource
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    // Generic per-document rules for common collections
    match /{collection}/{documentId=**} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}